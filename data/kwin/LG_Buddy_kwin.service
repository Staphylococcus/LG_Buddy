[Unit]
Description=LG Buddy installed KWin integration loader
After=graphical-session.target plasma-kwin_wayland.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/lg-buddy kwin-setup
TimeoutStartSec=180
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
